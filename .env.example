# =====================================================================
# HighSystem — Environment configuration
# Copy this file to `.env.local` and fill in real values.
# NEVER commit `.env.local` or real secrets to Git.
# =====================================================================

# ---------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://highsysteme.com

# ---------------------------------------------------------------------
# Contact / Lead form delivery
# The contact form posts to /api/contact. Configure ONE or more targets.
# If none are configured, submissions are logged server-side (dev only).
# ---------------------------------------------------------------------
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
# Generic webhook (Make.com, Zapier, n8n, custom). Receives full JSON payload.
CONTACT_WEBHOOK_URL=
# Optional: dedicated integrations (leave blank to disable)
NOTION_API_KEY=
NOTION_LEADS_DATABASE_ID=
HUBSPOT_ACCESS_TOKEN=
GHL_API_KEY=
GHL_LOCATION_ID=
GOOGLE_SHEETS_WEBHOOK_URL=

# Optional: SMTP for transactional email (contact + payment confirmations)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ---------------------------------------------------------------------
# Admin (manual payment verification / lead review)
# Protects /api/admin/* routes. Use a long random string.
# ---------------------------------------------------------------------
ADMIN_API_TOKEN=

# ---------------------------------------------------------------------
# Payments — Stripe (hosted Checkout). Leave blank to keep disabled.
# Enable by adding real keys. Use test keys (sk_test_..., pk_test_...) first.
# ---------------------------------------------------------------------
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ---------------------------------------------------------------------
# Payments — PayPal. Leave blank to keep disabled.
# ---------------------------------------------------------------------
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# 'sandbox' or 'live'
PAYPAL_ENVIRONMENT=sandbox

# ---------------------------------------------------------------------
# Payments — currency & manual/local methods
# ---------------------------------------------------------------------
PAYMENT_CURRENCY=MAD

# Moroccan bank transfer details (shown on the payment page)
BANK_NAME=
BANK_ACCOUNT_HOLDER=
BANK_RIB=
BANK_IBAN=
BANK_SWIFT=

# Cash Plus (or other manual local method)
CASHPLUS_RECIPIENT_NAME=

# Payment support contacts (shown to clients)
PAYMENT_SUPPORT_EMAIL=
PAYMENT_SUPPORT_WHATSAPP=

# ---------------------------------------------------------------------
# Private payment links
# Secret used to sign/verify tokenized private payment & portal links.
# Use a long random string. Rotate if leaked.
# ---------------------------------------------------------------------
PAYMENT_LINK_SECRET=
